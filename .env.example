# Copy to .env in the project root for local development.
# In production/containers, set these as environment variables instead.
# Never commit a real .env file (it is gitignored).

# Server (optional locally — defaults to 8080)
PORT=8080

# Neon PostgreSQL (JDBC + SSL required)
# Convert Neon "Connection string" to JDBC form if needed:
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# becomes:
#   jdbc:postgresql://HOST:5432/DB?sslmode=require
# (username/password go in DATABASE_USERNAME / DATABASE_PASSWORD)
DATABASE_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
DATABASE_USERNAME=YOUR_NEON_USERNAME
DATABASE_PASSWORD=YOUR_NEON_PASSWORD

# First Neon schema bootstrap uses update by default.
# After schema is confirmed, prefer:
# JPA_DDL_AUTO=validate
JPA_DDL_AUTO=update

# JWT (required) — at least 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-openssl-rand-base64-32-output!!
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Browser CORS origins (comma-separated). Leave empty for mobile apps / Postman only.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# Dev only — keep false in production
EXPOSE_TEST_ENDPOINT=false

# AWS S3
AWS_S3_BUCKET_NAME=cleancity-reports
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Firebase — paste the full service account JSON on one line, or use a local file path
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json

# Google Cloud Vision (optional if same as Firebase — otherwise set separately)
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-credentials.json

# Debug (optional)
SHOW_SQL=false
